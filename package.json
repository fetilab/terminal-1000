{
  "name": "terminal-1000",
  "version": "0.2.4",
  "private": true,
  "description": "Terminal and remote connection manager (independent reimplementation)",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "dev": "pnpm --filter @t1000/desktop dev",
    "build": "pnpm --filter @t1000/desktop build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "check:ignored": "node scripts/check-ignored-source.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
