{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@t1000/shared": ["../../packages/shared/src/index.ts"],
      "@t1000/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": [
    "src/renderer/**/*",
    "src/preload/index.d.ts"
  ]
}
