{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "types": ["node", "electron-vite/node"],
    "lib": ["ES2023"],
    "baseUrl": ".",
    "paths": {
      "@main/*": ["src/main/*"],
      "@t1000/shared": ["../../packages/shared/src/index.ts"],
      "@t1000/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "electron.vite.config.ts"
  ]
}
