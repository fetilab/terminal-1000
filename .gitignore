# ── 依赖与构建产物 ───────────────────────────────
node_modules/
dist/
out/
# electron-vite 在 out/ 被占用时会另建 out.dev.<ts> / out.old.<ts> —— 同样是产物
apps/desktop/out.*/
# 只忽略根目录的构建缓存：apps/desktop/build/ 是 electron-builder 的**资源目录**
# （图标 SVG/PNG 真身就在里面），用裸 `build/` 会把产品资源一起排除掉
/build/
release/
coverage/
*.tsbuildinfo
*.log

# 打包/测试用的本机暂存（scripts/pack-local.sh 会在这里生成垫片）
/.pack-work/
/.vitest-tmp/
apps/desktop/.vitest-tmp/

# ── 本地环境 ────────────────────────────────────
.env
.env.local
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!/.vscode/settings.json.example

# ── 运行时数据（含用户凭证，绝不入库）──────────────
data/
*.db
*.db-wal
*.db-shm
secrets/
backups/
# ⚠️ 必须锚定到仓库根：裸 `notes/` 会匹配**任意层级**的 notes 目录，
# 曾经静默排除了产品源码 apps/.../services/notes/ 与 features/notes/（整个笔记域没进过 git）。
/notes/
session-log/

# ── 第三方二进制（不可再分发，不入库）───────────────
*.deb
*.rpm
*.AppImage
*.flatpak

# ── 开发期验证截图（非交付物）──────────────────
# docs/ 为工程文档，需要入库；仅忽略其中的临时截图
docs/*.png
docs/shot-*.png

# vitest/electron-vite 运行期临时产物
apps/desktop/vitest.config.ts.timestamp-*.mjs
apps/desktop/electron.vite.config.*.mjs
_tmp_*

# ── Android（apps/android）──────────────────────────────────────────────
# 重要：这个工程的"源码"只有 Kotlin + Gradle + 脚本；下面全是**可再生成**的
# 东西，尤其是 jniLibs（212MB 的 libnode/ICU）与 assets（46MB 的渲染层副本），
# 一旦入库会把仓库撑到不可用。重建方式见 apps/android/README 与 scripts/：
#   scripts/fetch-runtime.sh <abi>     → jniLibs（Node + node-pty）
#   scripts/build-rootfs.sh <abi>      → jniLibs 里的 proot + assets/rootfs.tgz
#   node-host/build.mjs                → assets/host、assets/renderer、assets/resources
apps/android/.gradle/
apps/android/build/
apps/android/app/build/
apps/android/local.properties
apps/android/_cache/
apps/android/node-host/node_modules/
apps/android/node-host/out/
apps/android/app/src/main/jniLibs/
apps/android/app/src/main/assets/host/
apps/android/app/src/main/assets/renderer/
apps/android/app/src/main/assets/resources/
apps/android/app/src/main/assets/rootfs.tgz
